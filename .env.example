# Copy to .env for local docker compose / runtime
AUTH_SECRET=replace-with-long-random-string
APP_PORT=3000
DATA_DIR=./data

# ghcr.io (GitHub Container Registry) image
# Full host is always: ghcr.io/<owner>/<image>:<tag>
GHCR_IO_IMAGE=ghcr.io/christopherstainberg-oss/motionrx-stretch:latest

# Optional: auth for private ghcr.io pulls (Watchtower / compose pull)
# Create a PAT with read:packages (and write:packages if you push)
GHCR_IO_USER=
GHCR_IO_TOKEN=

WATCHTOWER_POLL_INTERVAL=3600

# Optional: SpaceXAI / xAI for Jeffery live model (offline clinical coach always works)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
