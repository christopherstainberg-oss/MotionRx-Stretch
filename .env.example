# Copy to .env for local docker compose / runtime
# Portainer: set the same names as Stack environment variables
#   (see portainer.stack.env.example)

AUTH_SECRET=replace-with-long-random-string
# Session cookies: false for http://localhost (default in compose). true when served over HTTPS.
COOKIE_SECURE=false
APP_PORT=3000
DATA_DIR=./data

# Comma-separated admin emails (User Analytics directory: users, emails, created dates)
# Example: ADMIN_EMAILS=you@example.com,ops@example.com
ADMIN_EMAILS=

# ghcr.io (GitHub Container Registry) image
# Full host is always: ghcr.io/<owner>/<image>:<tag>
# Package is currently PRIVATE — Portainer/Watchtower need credentials to pull.
GHCR_IO_IMAGE=ghcr.io/christopherstainberg-oss/motionrx-stretch:latest

# Required for private ghcr.io pulls (compose pull, Portainer registry, Watchtower)
# Create a classic PAT with at least: read:packages
# Portainer → Registries → Add registry → ghcr.io → Username + PAT
GHCR_IO_USER=
GHCR_IO_TOKEN=

WATCHTOWER_POLL_INTERVAL=30

# Optional: SpaceXAI / xAI for Jeffery live model (offline clinical coach always works)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
