# Copy to .env for local docker compose / runtime
AUTH_SECRET=replace-with-long-random-string
APP_PORT=3000
DATA_DIR=./data
GHCR_IMAGE=ghcr.io/your-org/motionrx-stretch:latest
WATCHTOWER_POLL_INTERVAL=3600

# Optional: SpaceXAI / xAI for Jeffery live model (offline clinical coach always works)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
