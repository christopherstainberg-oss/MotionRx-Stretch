# Portainer → Stacks → Environment variables
# Copy these keys into the stack env editor (values only; do not commit secrets).

# Required in production
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Host port published for the app
APP_PORT=3000

# Image (lowercase host/name/tag)
GHCR_IO_IMAGE=ghcr.io/christopherstainberg-oss/motionrx-stretch:latest

# Required while the ghcr.io package is PRIVATE
# Portainer → Registries must also list ghcr.io with the same credentials
GHCR_IO_USER=your-github-username
GHCR_IO_TOKEN=ghp_pat_with_read_packages

# Watchtower poll interval (seconds)
WATCHTOWER_POLL_INTERVAL=3600

# Optional Jeffery live model
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning
